---
import { documentSlug } from '@scadable/core';
import type { DocumentOwner } from '@scadable/core';
import ScadablePolicy from './ScadablePolicy.astro';

export type Props = DocumentOwner & {
  /** Class on the wrapper element. Both `class` and `className` are accepted. */
  class?: string;
  className?: string;
  /**
   * Override the base. Default "https://policy.scadable.com" for a token and
   * "https://files.scadable.com" for a tenant.
   */
  baseUrl?: string;
};

// Thin wrapper: ScadablePolicy with the doc type fixed, or for a tenant the slug that
// type is published under. A new document type is a prop value on ScadablePolicy,
// never a new package.
---

{
  Astro.props.tenant !== undefined ? (
    <ScadablePolicy {...Astro.props} document={documentSlug('cookie_policy')} />
  ) : (
    <ScadablePolicy {...Astro.props} docType="cookie_policy" />
  )
}
