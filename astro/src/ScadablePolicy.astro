---
import { fetchDocument, fetchPolicy } from '@scadable/core';
import type { DocumentSource, Policy } from '@scadable/core';

export type Props = DocumentSource & {
  /** Class on the wrapper element. Both `class` and `className` are accepted. */
  class?: string;
  className?: string;
  /**
   * Override the base. Default "https://policy.scadable.com" for a token and
   * "https://files.scadable.com" for a tenant.
   */
  baseUrl?: string;
};

const props = Astro.props;
const { class: classProp, className, baseUrl } = props;
const docType = props.docType ?? 'privacy_policy';

// Hybrid by design. Bake the currently published document into the static HTML at
// build / SSR time, so the policy text and the "by scadable.com" backlink are in
// the markup a crawler sees (good for SEO) and paint instantly with no layout
// shift. revalidate:false keeps this build fetch un-cached; staying current
// afterwards is the browser refresh script's job (below), so editing the policy in
// SCADABLE never means a redeploy on the customer's side. A tenant's document comes
// back already checked against the allowlist in @scadable/core, or as a plain link.
let html: string;
if (props.tenant !== undefined) {
  const doc = await fetchDocument(
    { tenant: props.tenant, document: props.document },
    { revalidate: false, ...(baseUrl ? { baseUrl } : {}) },
  );
  html = doc.html;
} else {
  const policy: Policy = await fetchPolicy(props.token, {
    docType,
    revalidate: false,
    ...(baseUrl ? { baseUrl } : {}),
  });
  html = policy.html;
}

const wrapperClass = ['scadable-policy', classProp, className].filter(Boolean).join(' ');
---

{
  props.tenant !== undefined ? (
    <div
      class={wrapperClass}
      data-scadable-tenant={props.tenant}
      data-scadable-document={props.document}
      data-scadable-base-url={baseUrl}
      set:html={html}
    />
  ) : (
    <div
      class={wrapperClass}
      data-scadable-policy
      data-scadable-token={props.token}
      data-scadable-doc-type={docType}
      data-scadable-base-url={baseUrl}
      set:html={html}
    />
  )
}

<script>
  import { fetchDocument } from '@scadable/core';

  // Live refresh, runs in the browser: re-fetch each baked policy and swap it for
  // whatever version is currently published, so edits made in SCADABLE show up
  // without a rebuild. For a token this is a plain fetch; the token, doc type, and
  // base URL come from the wrapper's data attributes. If the fetch is blocked (a
  // strict Content-Security-Policy) or the visitor is offline, the baked copy is
  // kept, so the page is never blank. One hoisted script handles every instance
  // on the page.
  const DEFAULT_BASE_URL = 'https://policy.scadable.com';
  for (const el of document.querySelectorAll('[data-scadable-policy]')) {
    const token = el.getAttribute('data-scadable-token');
    if (!token) continue;
    const docType = el.getAttribute('data-scadable-doc-type') || 'privacy_policy';
    const baseUrl = (el.getAttribute('data-scadable-base-url') || DEFAULT_BASE_URL).replace(/\/+$/, '');
    const url = `${baseUrl}/policy/${encodeURIComponent(token)}?doc_type=${encodeURIComponent(docType)}&format=json`;
    fetch(url, { cache: 'no-store' })
      .then((res) => (res.ok ? res.json() : null))
      .then((policy) => {
        if (policy && typeof policy.html === 'string') el.innerHTML = policy.html;
      })
      .catch(() => {
        /* keep the baked copy if the browser fetch is blocked or offline */
      });
  }

  // A tenant's document is refreshed through @scadable/core, because it has to
  // pass the allowlist check there before it is inserted into the page.
  for (const el of document.querySelectorAll('[data-scadable-tenant]')) {
    const tenant = el.getAttribute('data-scadable-tenant');
    const slug = el.getAttribute('data-scadable-document');
    if (!tenant || !slug) continue;
    const baseUrl = el.getAttribute('data-scadable-base-url') || undefined;
    fetchDocument({ tenant, document: slug }, { baseUrl, revalidate: false })
      .then((doc) => {
        el.innerHTML = doc.html;
      })
      .catch(() => {
        /* keep the baked copy if the browser fetch is blocked or offline */
      });
  }
</script>
